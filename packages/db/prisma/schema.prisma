generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum MessageRole {
  system
  user
  assistant

  @@map("message_role")
}

enum SubagentTaskStatus {
  pending
  running
  completed
  failed
  blocked_on_approval
  blocked_on_provider
  cancelled

  @@map("subagent_task_status")
}

enum ChatInteractionKind {
  tool_approval
  user_prompt

  @@map("chat_interaction_kind")
}

enum ChatInteractionStatus {
  pending
  approved
  denied
  answered
  superseded

  @@map("chat_interaction_status")
}

enum ChatRunStatus {
  pending
  running
  completed
  failed
  cancelled

  @@map("chat_run_status")
}

model ChatSession {
  id               String               @id
  title            String?
  /** True once a title is pinned (user rename or LLM auto-title). */
  autoTitled       Boolean              @default(false) @map("auto_titled")
  cwd              String?
  /** Canonical workspace directory identity; nullable only for legacy rows. */
  workspaceDevice  String?              @map("workspace_device")
  workspaceInode   String?              @map("workspace_inode")
  mode             String               @default("build")
  permissionMode   String?              @map("permission_mode")
  model            String?
  revision         Int                  @default(0)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  messages         ChatMessage[]
  interactions     ChatInteraction[]
  subagentTasks    SubagentTask[]
  contextState     SessionContextState?
  runs             ChatRun[]
  turnReverts      ChatTurnRevert[]

  @@index([updatedAt], map: "sessions_updated_at_idx")
  @@map("sessions")
}

model SessionContextState {
  id                  String   @id @default(cuid())
  sessionId           String   @unique(map: "session_context_states_session_id_key") @map("session_id")
  summary             String
  anchorMessageId     String   @map("anchor_message_id")
  coveredMessageCount Int      @map("covered_message_count")
  estimatedTokens     Int      @map("estimated_tokens")
  tier                String
  model               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_context_states")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String      @map("session_id")
  messageId String      @map("message_id")
  role      MessageRole
  model     String?
  sequence  Int
  payload   Json
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parts   ChatMessagePart[]

  @@unique([sessionId, messageId], map: "messages_session_id_message_id_key")
  @@unique([sessionId, sequence], map: "messages_session_id_sequence_key")
  @@index([sessionId, sequence], map: "messages_session_id_sequence_idx")
  @@index([sessionId, role], map: "messages_session_id_role_idx")
  @@map("messages")
}

model ChatMessagePart {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  partIndex Int      @map("part_index")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, partIndex], map: "message_parts_message_id_part_index_key")
  @@index([messageId, partIndex], map: "message_parts_message_id_part_index_idx")
  @@map("message_parts")
}

model ChatRun {
  id             String        @id
  sessionId      String        @map("session_id")
  clientTurnId   String        @map("client_turn_id")
  status         ChatRunStatus @default(pending)
  baseRevision   Int           @map("base_revision")
  finalRevision  Int?          @map("final_revision")
  error          String?
  startedAt      DateTime?     @map("started_at")
  finishedAt     DateTime?     @map("finished_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  session ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  events  ChatRunEvent[]

  @@unique([sessionId, clientTurnId], map: "chat_runs_session_id_client_turn_id_key")
  @@index([sessionId, status], map: "chat_runs_session_id_status_idx")
  @@map("chat_runs")
}

model ChatRunEvent {
  id        String   @id @default(cuid())
  runId     String   @map("run_id")
  cursor    Int
  kind      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  run ChatRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, cursor], map: "chat_run_events_run_id_cursor_key")
  @@index([runId, cursor], map: "chat_run_events_run_id_cursor_idx")
  @@map("chat_run_events")
}

model ChatTurnRevert {
  id         String    @id @default(cuid())
  sessionId  String    @map("session_id")
  turnKey    String    @map("turn_key")
  messages   Json
  state      String    @default("undone")
  createdAt  DateTime  @default(now()) @map("created_at")
  reappliedAt DateTime? @map("reapplied_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, state, createdAt], map: "chat_turn_reverts_session_state_created_at_idx")
  @@map("chat_turn_reverts")
}

model ChatInteraction {
  id          String                @id @default(cuid())
  sessionId   String                @map("session_id")
  toolCallId  String                @map("tool_call_id")
  kind        ChatInteractionKind
  status      ChatInteractionStatus @default(pending)
  payload     Json
  response    Json?
  resolvedAt  DateTime?             @map("resolved_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, toolCallId], map: "chat_interactions_session_id_tool_call_id_key")
  @@index([sessionId, status], map: "chat_interactions_session_id_status_idx")
  @@index([status, updatedAt], map: "chat_interactions_status_updated_at_idx")
  @@map("chat_interactions")
}

model SubagentTask {
  id              String             @id
  parentSessionId String             @map("parent_session_id")
  prompt          String
  status          SubagentTaskStatus @default(pending)
  mode            String             @default("plan")
  model           String?
  allowedTools    Json               @default("[]") @map("allowed_tools")
  output          Json?
  error           String?
  startedAt       DateTime?          @map("started_at")
  finishedAt      DateTime?          @map("finished_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  parentSession ChatSession @relation(fields: [parentSessionId], references: [id], onDelete: Cascade)

  @@index([parentSessionId, createdAt], map: "subagent_tasks_parent_session_created_at_idx")
  @@index([status, updatedAt], map: "subagent_tasks_status_updated_at_idx")
  @@map("subagent_tasks")
}
