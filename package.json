{
  "name": "lightcode",
  "version": "0.1.0",
  "private": true,
  "description": "Lightcode — a local AI coding agent with terminal and browser interfaces.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build-dist.ts",
    "release": "bun scripts/release.ts",
    "test": "bun test",
    "test:parity": "bun test packages/ai/src/parity",
    "typecheck": "bunx tsc --noEmit && bun run --cwd apps/web typecheck && bun run tool-schema:check",
    "tool-schema:check": "bun test packages/ai/src/agent-tools-schema-preflight.test.ts",
    "db:push": "bunx --bun prisma db push --config packages/db/prisma.config.ts",
    "db:push:accept-data-loss": "bunx --bun prisma db push --config packages/db/prisma.config.ts --accept-data-loss",
    "db:generate": "bunx --bun prisma generate --config packages/db/prisma.config.ts",
    "db:validate": "bunx --bun prisma validate --config packages/db/prisma.config.ts",
    "postinstall": "bun scripts/postinstall.ts || exit 0",
    "server:dev": "bun --watch --env-file=.env apps/server/src/index.ts",
    "server:start": "bun --env-file=.env apps/server/src/index.ts",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "cli:dev": "bun apps/cli/src/index.tsx",
    "cli:start": "bun apps/cli/src/index.tsx"
  },
  "bin": {
    "lightcode": "./dist/cli.js"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.7",
    "hono": "4.13.7",
    "mysql2": "3.24.3",
    "shell-quote": "1.10.0",
    "valibot": "1.4.2"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "prisma": "7.10.0",
    "typescript": "^5.9.3"
  }
}
