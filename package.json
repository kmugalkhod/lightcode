{
  "name": "lightcode",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "server:dev": "bun run --cwd apps/server dev",
    "server:start": "bun run --cwd apps/server start",
    "cli:dev": "bun run --cwd apps/cli dev",
    "cli:start": "bun run --cwd apps/cli start",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
