{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@lightcode/shared": ["packages/shared/src/index.ts"],
      "@lightcode/db": ["packages/db/src/index.ts"],
      "@lightcode/db/server": ["packages/db/src/server.ts"],
      "@lightcode/db/types": ["packages/db/src/types.ts"]
    }
  }
}
