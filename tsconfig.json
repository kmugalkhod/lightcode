{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react"
  },
  "include": [
    "apps/server/src/**/*.ts",
    "apps/cli/src/**/*.ts",
    "apps/cli/src/**/*.tsx",
    "packages/shared/src/**/*.ts",
    "packages/ai/src/**/*.ts",
    "packages/ai/src/**/*.tsx",
    "packages/tools/src/index.ts",
    "packages/tools/src/runtime.ts"
  ]
}
