  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Commit a primary action.",
      "html": "<button class=\"ds-control ds-primary\">Choose project</button>",
      "css": ".ds-primary{font-family:\"Geist Variable\",sans-serif;min-height:36px;border:0;border-radius:8px;padding:7px 12px;background:var(--accent);color:#23170c;font-size:12px;font-weight:650;cursor:pointer}.ds-primary:hover{background:#ffc077}.ds-control:focus-visible{outline:2px solid var(--accent);outline-offset:2px}@media(max-width:760px){.ds-primary{min-height:44px}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A quieter alternative beside the primary action.",
      "html": "<button class=\"ds-control ds-secondary\">Use this model ID</button>",
      "css": ".ds-secondary{font-family:\"Geist Variable\",sans-serif;min-height:36px;border:1px solid var(--border);border-radius:8px;padding:7px 12px;background:var(--elevated);color:var(--text-secondary);font-size:12px;font-weight:650;cursor:pointer}.ds-secondary:hover{border-color:#3e4b5d;color:var(--text)}.ds-control:focus-visible{outline:2px solid var(--accent);outline-offset:2px}@media(max-width:760px){.ds-secondary{min-height:44px}}"
    },
    {
      "name": "Search",
      "kind": "input",
      "refersTo": "search",
      "description": "Shared session and model search treatment.",
      "html": "<label class=\"ds-search\"><input aria-label=\"Search sessions\" placeholder=\"Find a session…\"></label>",
      "css": ".ds-search{display:flex;min-height:44px;align-items:center;border:1px solid var(--border);border-radius:8px;padding:0 10px;background:var(--inset);color:var(--text-muted)}.ds-search:focus-within{border-color:var(--accent)}.ds-search input{font-family:\"Geist Variable\",sans-serif;width:100%;min-width:0;border:0;outline:none;background:transparent;color:var(--text);padding:10px 0;font-size:13px}.ds-search input::placeholder{color:var(--text-muted)}"
    },
    {
      "name": "Saved session",
      "kind": "nav",
      "refersTo": "session-active",
      "description": "Quiet rows support direct continuation.",
      "html": "<nav aria-label=\"Saved conversations\"><button class=\"ds-control ds-session\" aria-current=\"page\">Improve the project browser</button></nav>",
      "css": ".ds-session{font-family:\"Geist Variable\",sans-serif;width:100%;min-height:58px;border:0;border-radius:8px;padding:8px 9px;text-align:left;background:var(--elevated);color:var(--text);font-size:13px;cursor:pointer;transition:background-color 160ms ease-out,color 160ms ease-out}.ds-session:hover{background:var(--panel)}.ds-control:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Selected model",
      "kind": "custom",
      "refersTo": "model-selected",
      "description": "Model name and exact ID retain a clear selected state.",
      "html": "<button class=\"ds-control ds-model\"><strong>Current model</strong><small>provider/model-id</small></button>",
      "css": ".ds-model{font-family:\"Geist Variable\",sans-serif;width:100%;min-height:64px;border:0;border-radius:8px;padding:12px;text-align:left;background:var(--accent-soft);color:var(--accent-text);cursor:pointer}.ds-model strong{display:block;font-size:14px;font-weight:550}.ds-model small{display:block;margin-top:4px;font:11px var(--mono)}.ds-model:hover{background:var(--elevated)}.ds-control:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "Workspace Ribbon",
    "overview": "Lightcode Web is one local coding workspace shared with the CLI. Keep the project conversation central and avoid dashboard cards, decorative metrics, or browser-only concepts that compete with the work.\n\nThe interface is a precise, quiet coding instrument: adjacent charcoal fields carry the work and amber keeps project context legible. Extend this established world without simulated physical materials or a new visual identity.",
    "keyCharacteristics": [
      "Persistent project context.",
      "Charcoal tonal depth and amber state.",
      "Readable conversation with compact controls."
    ],
    "rules": [
      {
        "name": "The Context Accent Rule",
        "body": "Use amber to locate the project, current selection, focus, and next action.",
        "section": "colors"
      },
      {
        "name": "The Reading Rhythm Rule",
        "body": "Give conversation prose more line-height than compact navigation and controls.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Separate persistent regions with tone and hairlines; reserve soft elevation for overlapping dialogs and menus.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve CLI terminology, full control hit areas, visible run and permission state, contextual errors, and direct session continuation.",
      "Do keep project selection explicit, native-first, and backed by the authenticated common-location fallback."
    ],
    "donts": [
      "Don't imitate IDE chrome, show terminal-only customization as disabled navigation, hide permissions, or turn the application into a dashboard.",
      "Don't silently probe local folders or accept browser-supplied arbitrary paths."
    ]
  }
}
